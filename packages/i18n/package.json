{
  "name": "@gfg/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Internacionalização: traduções da interface (i18next), escolha de idioma e formatos (Intl)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*.json": "./locales/*.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@gfg/core": "workspace:*",
    "i18next": "^26.4.2"
  },
  "devDependencies": {
    "@gfg/config": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
