# =============================================================================
# Supabase CLI — variáveis opcionais (lista de referência)
#
# O CLI lê estas variáveis do AMBIENTE do terminal ou da automação (CI, etapa 10).
# No uso manual você não precisa delas: o CLI pergunta a senha e abre o login no navegador.
#
# Para usar no PowerShell (só na janela atual, nada fica salvo em arquivo):
#   $env:SUPABASE_DB_PASSWORD = "sua-senha"
#
# Lista completa e explicações: docs/ENVIRONMENT.md
# SECRETAS: nunca coloque valores reais neste arquivo nem em arquivos do Git.
# =============================================================================

# Senha do banco do projeto (usada por `supabase link` e `supabase db push`).
SUPABASE_DB_PASSWORD=

# Token de acesso pessoal do Supabase (alternativa ao `supabase login`, para automação).
SUPABASE_ACCESS_TOKEN=
