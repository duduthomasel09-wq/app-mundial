# =============================================================================
# Painel administrativo (apps/admin) — variáveis de ambiente
#
# Desenvolvimento: copie para `apps/admin/.env.local` e preencha (esse arquivo não vai para o Git).
# staging/produção: cadastre na hospedagem (Vercel) — nunca em arquivo versionado.
# Lista completa e explicações: docs/ENVIRONMENT.md
#
# NUNCA coloque chaves reais neste arquivo. Aqui só há exemplos vazios ou valores padrão.
# =============================================================================

# --- Públicas (vão para o navegador: qualquer pessoa pode ver) ---------------

# Ambiente: development | staging | production   (staging = teste/homologação)
# Opcional · padrão: development
NEXT_PUBLIC_APP_ENV=development

# Supabase — Project Settings → API Keys (veja docs/SUPABASE.md).
# Use SÓ a chave pública (publishable/anon). NUNCA a "secret"/"service_role".
# Opcional em development · necessária com ADMIN_AUTH_MODE=supabase e em production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do painel (só a origem, sem caminho). Usado no link do e-mail de
# recuperação de senha: <NEXT_PUBLIC_ADMIN_URL>/auth/confirmar (ADR 0017).
# development: vazio = http://localhost:3000 · staging/production: obrigatório e https://
NEXT_PUBLIC_ADMIN_URL=

# --- Só do servidor (não vão para o navegador) --------------------------------

# Idioma do painel: pt-BR | en | es
# Opcional · padrão: pt-BR
ADMIN_LOCALE=pt-BR

# Autenticação do painel: disabled | supabase
#   disabled = sem login (só development). Em staging e production é BLOQUEADO: o painel vai
#              para /login (ADR 0017).
#   supabase = login real com e-mail e senha (só editor/admin — ADR 0016) e recuperação de
#              senha (ADR 0017).
#              Exige NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY preenchidas.
# Opcional · padrão: disabled
ADMIN_AUTH_MODE=disabled
